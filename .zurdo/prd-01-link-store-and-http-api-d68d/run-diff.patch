Link, 0, len(s.links))\n\tfor _, l := range s.links {\n\t\tout = append(out, l)\n\t}\n\tsort.Slice(out, func(i, j int) bool { return out[i].Slug < out[j].Slug })\n\treturn out\n}\n\n// generateSlug returns an unused random slug. The caller holds s.mu.\nfunc (s *Store) generateSlug() (string, error) {\n\tn := big.NewInt(int64(len(slugAlphabet)))\n\tfor try := 0; try < maxGenerateTr; try++ {\n\t\tb := make([]byte, generatedLen)\n\t\tfor i := range b {\n\t\t\tr, err := rand.Int(rand.Reader, n)\n\t\t\tif err != nil {\n\t\t\t\treturn \"\", err\n\t\t\t}\n\t\t\tb[i] = slugAlphabet[r.Int64()]\n\t\t}\n\t\tif _, ok := s.links[string(b)]; !ok {\n\t\t\treturn string(b), nil\n\t\t}\n\t}\n\treturn \"\", errors.New(\"could not generate an unused slug\")\n}\n\n// save writes the whole file via a temp file and rename. The caller holds s.mu.\nfunc (s *Store) save() error {\n\tdata, err := json.Marshal(s.sorted())\n\tif err != nil {\n\t\treturn err\n\t}\n\ttmp, err := os.CreateTemp(filepath.Dir(s.path), filepath.Base(s.path)+\".tmp-*\")\n\tif err != nil {\n\t\treturn err\n\t}\n\tdefer os.Remove(tmp.Name())\n\tif _, err := tmp.Write(data); err != nil {\n\t\ttmp.Close()\n\t\treturn err\n\t}\n\tif err := tmp.Close(); err != nil {\n\t\treturn err\n\t}\n\treturn os.Rename(tmp.Name(), s.path)\n}\nEOF\nsed -i '1,2d' internal/store/preauthored_task_01_test.go\nhead -3 internal/store/preauthored_task_01_test.go\ngofmt -l .; go vet ./... && go test ./... 2>&1 | tail"}},"wire_ingest_context":{"toolu_01PiH3pvCyhm6zUufsAKPAEz":{"cwd":"/home/bob/workspace/utils/demos/zurdo-demo/.carol/worktrees/phase-01"}}}
