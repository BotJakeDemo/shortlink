# For the demo, .zurdo/, .carol/ and .claude/ are committed whole, so every
# zurdo run's state (prd.json, run-diff.patch, iterations, reports) lands in
# its run pull request. Only what would break the loop, or is a machine-local
# cache, stays out:

# zurdo: run lock, Vela's socket, atomic-write temp files
/.zurdo/lock
/.zurdo/vela/
/.zurdo/**/*.lock
/.zurdo/**/*.tmp
# zurdo: structural and retrieval indexes, rebuilt per machine (large, binary)
/.zurdo/lumen/
/.zurdo/pyxis/

# carol: per-phase git worktrees (nested checkouts can't be committed)
/.carol/worktrees/
# carol: an agent session's messages to the tick; read once, never committed
/.carol/outbox.json
/.carol/handoff.md

# per-machine environment (CAROL_APP_KEY)
/.envrc

/shortlink
*.test
